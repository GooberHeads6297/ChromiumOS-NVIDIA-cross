From: nvidia-generic <nvidia-generic@local>
Subject: [PATCH] ozone: nvidia-drm modeset commit + display ID / master recovery

Fake GETCONNECTOR alone left Ash frozen: CommitModeset never bound
controller_, FindDisplay missed host display IDs, and SchedulePageFlip
no-oped without DRM master. Treat nvidia connectors with modes as
connected, fall back to the sole GPU display on ID mismatch, reclaim
SetMaster for presents, and promote modeset logs to WARNING.

diff --git a/ui/ozone/platform/drm/common/drm_util.cc b/ui/ozone/platform/drm/common/drm_util.cc
--- a/ui/ozone/platform/drm/common/drm_util.cc
+++ b/ui/ozone/platform/drm/common/drm_util.cc
@@ -690,8 +690,24 @@
       continue;
     }
 
-    if (connector->connection == DRM_MODE_CONNECTED) {
+    // nvidia-drm often reports connection=0 to Chrome while the panel is lit
+    // (modes + encoder still present). Treat modes>0 as connected so Ash can
+    // build a DisplaySnapshot and CommitModeset → SchedulePageFlip.
+    const std::optional<std::string> driver = drm.GetDriverName();
+    const bool nvidia_drm =
+        driver.has_value() &&
+        (*driver == "nvidia-drm" || *driver == "nvidia");
+    const bool treat_as_connected =
+        connector->connection == DRM_MODE_CONNECTED ||
+        (nvidia_drm && connector->count_modes > 0);
+    if (treat_as_connected) {
       if (connector->count_modes != 0) {
+        if (connector->connection != DRM_MODE_CONNECTED) {
+          LOG(WARNING) << "[CONNECTOR:" << connector->connector_id
+                       << "] nvidia-drm: treating modes>0 as connected "
+                       << "(kernel connection=" << connector->connection
+                       << ")";
+        }
         available_connectors.push_back(connector.get());
       } else {
         LOG(WARNING) << "[CONNECTOR:" << connector->connector_id
diff --git a/ui/ozone/platform/drm/common/drm_wrapper.cc b/ui/ozone/platform/drm/common/drm_wrapper.cc
--- a/ui/ozone/platform/drm/common/drm_wrapper.cc
+++ b/ui/ozone/platform/drm/common/drm_wrapper.cc
@@ -222,6 +222,11 @@
   TRACE_EVENT1("drm", "DrmWrapper::SetMaster", "path", device_path_.value());
   DCHECK(drm_fd_.is_valid());
   has_master_ = (drmSetMaster(drm_fd_.get()) == 0);
+  if (!has_master_) {
+    PLOG(WARNING) << "drmSetMaster failed for " << device_path_.value();
+  } else {
+    LOG(WARNING) << "drmSetMaster ok for " << device_path_.value();
+  }
   return has_master_;
 }
 
diff --git a/ui/ozone/platform/drm/gpu/drm_gpu_display_manager.cc b/ui/ozone/platform/drm/gpu/drm_gpu_display_manager.cc
--- a/ui/ozone/platform/drm/gpu/drm_gpu_display_manager.cc
+++ b/ui/ozone/platform/drm/gpu/drm_gpu_display_manager.cc
@@ -397,6 +397,12 @@
   }
 
   NotifyScreenManager(displays_, old_displays);
+  LOG(WARNING) << "GetDisplays: " << displays_.size() << " display(s)";
+  for (const auto& d : displays_) {
+    LOG(WARNING) << "GetDisplays: id=" << d->display_id()
+                 << " connector=" << d->GetPrimaryConnectorId()
+                 << " crtc=" << d->GetPrimaryCrtcId();
+  }
   return display_snapshots;
 }
 
@@ -760,6 +766,25 @@
       return display.get();
   }
 
+  // Host may query a stale/cached ID while GPU has exactly one panel (nvidia
+  // dual-GPU + connection probe races). Bind the sole display so Configure /
+  // HDCP / CommitModeset can proceed and controller_ gets mapped.
+  if (displays_.size() == 1) {
+    LOG(WARNING) << "FindDisplay: no ID " << display_id
+                 << "; using sole display ID " << displays_[0]->display_id();
+    return displays_[0].get();
+  }
+  if (!displays_.empty()) {
+    std::string ids;
+    for (const auto& d : displays_) {
+      if (!ids.empty())
+        ids += ",";
+      ids += base::NumberToString(d->display_id());
+    }
+    LOG(WARNING) << "FindDisplay: no ID " << display_id << "; known=[" << ids
+                 << "]";
+  }
+
   return nullptr;
 }
 
diff --git a/ui/ozone/platform/drm/gpu/drm_window.cc b/ui/ozone/platform/drm/gpu/drm_window.cc
--- a/ui/ozone/platform/drm/gpu/drm_window.cc
+++ b/ui/ozone/platform/drm/gpu/drm_window.cc
