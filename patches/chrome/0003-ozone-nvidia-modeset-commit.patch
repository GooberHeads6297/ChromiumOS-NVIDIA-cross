 #include <stdint.h>
 #include <utility>
 
+#include "base/logging.h"
 #include "base/time/time.h"
 #include "base/trace_event/trace_event.h"
 #include "third_party/skia/include/core/SkBitmap.h"
@@ -118,7 +119,12 @@
 
   last_submitted_planes_ = DrmOverlayPlane::Clone(planes);
 
-  if (!controller_ || !controller_->GetDrmDevice()->has_master()) {
+  if (!controller_) {
+    static int no_controller_logs = 0;
+    if (no_controller_logs++ < 30) {
+      LOG(WARNING) << "SchedulePageFlip: no controller_ widget=" << widget_
+                   << " (CommitModeset never bound window)";
+    }
     std::move(submission_callback)
         .Run(gfx::SwapResult::SWAP_ACK,
              /*release_fence=*/gfx::GpuFenceHandle());
@@ -126,6 +132,26 @@
     return;
   }
 
+  // frecon / modeset-test can race SetMaster at startup; reclaim before
+  // failing the present (otherwise Ash freezes after ~2 compositor frames).
+  if (!controller_->GetDrmDevice()->has_master()) {
+    if (!controller_->GetDrmDevice()->SetMaster()) {
+      static int no_master_logs = 0;
+      if (no_master_logs++ < 30) {
+        LOG(WARNING) << "SchedulePageFlip: no DRM master on "
+                     << controller_->GetDrmDevice()->device_path().value();
+      }
+      std::move(submission_callback)
+          .Run(gfx::SwapResult::SWAP_ACK,
+               /*release_fence=*/gfx::GpuFenceHandle());
+      std::move(presentation_callback)
+          .Run(gfx::PresentationFeedback::Failure());
+      return;
+    }
+    LOG(WARNING) << "SchedulePageFlip: reclaimed DRM master on "
+                 << controller_->GetDrmDevice()->device_path().value();
+  }
+
   controller_->SchedulePageFlip(std::move(planes),
                                 std::move(submission_callback),
                                 std::move(presentation_callback));
