# REFERENCE ONLY. Nothing applies this file.
#
# The config the build actually uses is:
#   overlay/overlay-nvidia-generic/kernel-config/chromiumos-x86_64-nvidia.flavour.config
# selected by CHROMEOS_KERNEL_SPLITCONFIG in the board's profiles/base/make.defaults, and
# installed into the kernel tree by sdk/build.sh during the link stage.
#
# This file previously described itself as a fragment to merge by hand, which meant it was
# never merged -- so none of it was in any build. It is kept because the reasoning below is
# worth having written down, and it would apply to a board that did enable these options.
#
# Three of the four "blockers" below were never real on this base. Grepping all of
# chromeos/config/ in the 6.12 tree: CONFIG_CFI_CLANG, CONFIG_LTO_CLANG* and
# CONFIG_TRIM_UNUSED_KSYMS have ZERO occurrences, so they were never enabled and never
# needed disabling. CONFIG_MODULE_SIG_FORCE appears exactly once, in reven's flavour
# config, which this board does not inherit from. See README.md in this directory.
#
# Verify a built kernel with:
#
#   overlay/overlay-nvidia-generic/x11-drivers/nvidia-open-drivers/files/\
#       build-nvidia-modules.sh --probe --kernel-src <kernel-build-dir>

# ---------------------------------------------------------------------------
# Required: loadable module support.
# ---------------------------------------------------------------------------
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# ---------------------------------------------------------------------------
# Clang Control Flow Integrity instruments indirect calls and validates that a
# function pointer's type matches at the call site. NVIDIA's modules register
# callbacks with the kernel that CFI has no type information for, so loading them
# under CFI trips a violation.
#
# Disabling CFI weakens a real exploit mitigation. That is an accepted, deliberate
# trade for this board: it exists to run an out-of-tree GPU driver, and CFI and
# out-of-tree modules are mutually exclusive in practice.
# ---------------------------------------------------------------------------
# CONFIG_CFI_CLANG is not set
# CONFIG_CFI_PERMISSIVE is not set

# ---------------------------------------------------------------------------
# Kernel-wide LTO requires every object in the final link to be LLVM bitcode.
# NVIDIA's OS-agnostic nv-kernel.o / nv-modeset-kernel.o are ordinary ELF objects, so
# the LTO link cannot consume them.
# ---------------------------------------------------------------------------
# CONFIG_LTO_CLANG is not set
# CONFIG_LTO_CLANG_FULL is not set
# CONFIG_LTO_CLANG_THIN is not set
CONFIG_LTO_NONE=y

# ---------------------------------------------------------------------------
# Module signing. We do not force signatures, because our modules are built after the
# kernel and signing them would mean managing a key in the build.
#
# Keep CONFIG_MODULE_SIG available (so signature *verification* still works for
# in-tree modules) but do not make it mandatory.
# ---------------------------------------------------------------------------
# CONFIG_MODULE_SIG_FORCE is not set

# ---------------------------------------------------------------------------
# Symbol trimming drops exported symbols that no in-tree module references. Since our
# module is added after configuration, anything it needs would already be gone.
# ---------------------------------------------------------------------------
# CONFIG_TRIM_UNUSED_KSYMS is not set

# ---------------------------------------------------------------------------
# DRM and the pieces nvidia-drm depends on for modesetting.
# ---------------------------------------------------------------------------
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_GEM_SHMEM_HELPER=y
CONFIG_DRM_TTM=m

# The iGPU stays in the image: it is the recovery console and the display owner during
# Stage 2 bring-up.
CONFIG_DRM_AMDGPU=y

# Nouveau is kept as a diagnostic fallback for proving PCI/DRM plumbing independently
# of NVIDIA's driver. Built as a module so it can be blacklisted; it must never load
# at the same time as nvidia.
CONFIG_DRM_NOUVEAU=m

# Simple framebuffer so there is always something on screen during early boot, even if
# every real driver fails to bind.
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB_SIMPLEFB=y

# ---------------------------------------------------------------------------
# Memory management features NVIDIA's modules use.
# ---------------------------------------------------------------------------
CONFIG_MMU_NOTIFIER=y
CONFIG_ZONE_DEVICE=y
CONFIG_HMM_MIRROR=y
CONFIG_DEVICE_PRIVATE=y

# ---------------------------------------------------------------------------
# Needed so the driver can map large BARs. This card exposes a 16 GB prefetchable
# BAR1, so resizable BAR support must be present.
# ---------------------------------------------------------------------------
CONFIG_PCI_REALLOC_ENABLE_AUTO=y
CONFIG_PCI_IOV=y

# ---------------------------------------------------------------------------
# Diagnostics. When a GPU driver misbehaves, these turn an unexplained hang into a
# log line, which matters because the display may be the thing that is broken.
# ---------------------------------------------------------------------------
CONFIG_PCIEAER=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_SERIAL_8250_CONSOLE=y
