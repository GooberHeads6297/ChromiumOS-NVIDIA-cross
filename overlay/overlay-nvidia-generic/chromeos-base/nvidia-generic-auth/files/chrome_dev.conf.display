# Mesa-first EGL (device_* client extensions). NVIDIA GBM for scanout buffers.

__EGL_VENDOR_LIBRARY_DIRS=/usr/share/glvnd/egl_vendor.d
__EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/50_mesa.json:/usr/share/glvnd/egl_vendor.d/10_nvidia.json
__EGL_EXTERNAL_PLATFORM_CONFIG_DIRS=/usr/share/egl/egl_external_platform.d
--gpu-sandbox-failures-fatal=0
--disable-gpu-sandbox
--ignore-gpu-blocklist
!--enable-native-gpu-memory-buffers
--disable-native-gpu-memory-buffers
--disable-gpu-memory-buffer-compositor-resources
!--use-gl=
!--use-angle=
