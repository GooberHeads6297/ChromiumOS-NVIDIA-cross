#
# Kernel flavour config for the nvidia-generic board.
#
# prepareconfig builds .config as:
#     chromeos/config/chromeos/base.config
#   + chromeos/config/chromeos/x86_64/common.config
#   + this file
# concatenated in that order, so anything set here wins over the first two.
#
# The first section is a verbatim copy of chromiumos-x86_64-generic.flavour.config, so we
# inherit every amd64-generic decision. The OVERRIDES section at the bottom then changes
# only what this board needs. Keeping the copy verbatim means a future rebase is a diff
# against the generic file rather than an archaeology exercise.
#
CONFIG_ACERHDF=m
CONFIG_ATA=y
CONFIG_ATA_GENERIC=y
CONFIG_ATA_PIIX=y
CONFIG_B43=m
CONFIG_B43_SDIO=y
CONFIG_BATTERY_SBS=m
CONFIG_CFG80211_WEXT=y
CONFIG_CLOCKSOURCE_WATCHDOG_MAX_SKEW_US=100
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
# CONFIG_CRASH_DUMP is not set
CONFIG_CRYPTO_DEV_VIRTIO=m
CONFIG_DEBUG_GPIO=y
CONFIG_DMADEVICES=y
CONFIG_DPM_WATCHDOG=y
CONFIG_DPM_WATCHDOG_TIMEOUT=25
CONFIG_DPM_WATCHDOG_WARNING_TIMEOUT=10
# CONFIG_DRM_FBDEV_EMULATION is not set
CONFIG_DRM_GMA500=y
# CONFIG_DRM_I2C_CH7006 is not set
# CONFIG_DRM_I2C_SIL164 is not set
CONFIG_DRM_I915=y
CONFIG_DRM_I915_FORCE_PROBE="*"
CONFIG_DRM_NOUVEAU=y
CONFIG_DRM_RADEON=m
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DW_DMAC=m
CONFIG_EARLY_PRINTK_DBGP=y
# CONFIG_EFIVAR_FS is not set
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_FUNCTION_PROFILER=y
CONFIG_GART_IOMMU=y
CONFIG_GPIO_SYSFS=y
CONFIG_HIST_TRIGGERS=y
CONFIG_HOTPLUG_PCI=y
CONFIG_HOTPLUG_PCI_ACPI=y
CONFIG_HOTPLUG_PCI_PCIE=y
CONFIG_I2C_CROS_EC_TUNNEL=m
CONFIG_I2C_DESIGNWARE_CORE=y
CONFIG_I2C_DESIGNWARE_PCI=y
CONFIG_INTEL_IDLE=y
CONFIG_INTEL_IDMA64=y
# CONFIG_INTEL_MEI is not set
CONFIG_INTEL_PMC_CORE=y
CONFIG_INTEL_PMT_TELEMETRY=y
CONFIG_INTEL_SCU_PLATFORM=y
CONFIG_INTEL_SOC_DTS_THERMAL=y
CONFIG_INTEL_VSEC=y
CONFIG_KERNEL_LZMA=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_KVM_AMD=y
CONFIG_KVM_INTEL=y
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,integrity,chromiumos,selinux,bpf"
CONFIG_MEDIA_CEC_SUPPORT=y
CONFIG_MFD_INTEL_LPSS_ACPI=y
CONFIG_MFD_INTEL_LPSS_PCI=y
CONFIG_MOUSE_BCM5974=m
# CONFIG_MOUSE_PS2_ALPS is not set
# CONFIG_MOUSE_PS2_SYNAPTICS is not set
CONFIG_MOUSE_SYNAPTICS_USB=m
CONFIG_NETFILTER_XTABLES_COMPAT=y
# CONFIG_NET_VENDOR_VERTEXCOM is not set
CONFIG_NFS_V2=m
CONFIG_PCIEPORTBUS=y
CONFIG_PCI_MSI=y
CONFIG_PHYLIB=y
CONFIG_PINCTRL_AMD=y
CONFIG_PINCTRL_BAYTRAIL=y
CONFIG_PINCTRL_BROXTON=y
CONFIG_PINCTRL_CANNONLAKE=y
CONFIG_PINCTRL_CHERRYVIEW=y
CONFIG_PINCTRL_GEMINILAKE=y
CONFIG_PINCTRL_ICELAKE=y
CONFIG_PINCTRL_SUNRISEPOINT=y
CONFIG_PINCTRL_TIGERLAKE=y
CONFIG_PTP_1588_CLOCK=m
CONFIG_RTL8187=m
CONFIG_RTL8192CU=m
CONFIG_RTL8XXXU=m
# CONFIG_RTLWIFI_DEBUG is not set
CONFIG_RTW88=m
CONFIG_RTW88_8822BE=m
CONFIG_RTW88_8822CE=m
CONFIG_RTW88_DEBUG=y
CONFIG_RTW88_DEBUGFS=y
CONFIG_SATA_AHCI=y
# CONFIG_SATA_PMP is not set
CONFIG_SCSI_VIRTIO=y
CONFIG_SKGE=m
CONFIG_SKY2=m
CONFIG_SND_HDA_CODEC_ANALOG=m
CONFIG_SND_HDA_CODEC_CA0110=m
CONFIG_SND_HDA_CODEC_CA0132=m
CONFIG_SND_HDA_CODEC_CIRRUS=m
CONFIG_SND_HDA_CODEC_CMEDIA=m
CONFIG_SND_HDA_CODEC_CONEXANT=m
CONFIG_SND_HDA_CODEC_REALTEK=m
CONFIG_SND_HDA_CODEC_SI3054=m
CONFIG_SND_HDA_CODEC_SIGMATEL=m
CONFIG_SND_HDA_CODEC_VIA=m
CONFIG_SND_HDA_POWER_SAVE_DEFAULT=15
CONFIG_SND_SOC_ADAU7002=m
CONFIG_SND_SOC_DMIC=m
CONFIG_SND_SOC_INTEL_CML_LP_DA7219_MAX98357A_MACH=m
CONFIG_SND_SOC_MAX98357A=m
CONFIG_SND_SOC_MAX98927=m
CONFIG_SND_SOC_SOF_ACPI=m
CONFIG_SND_SOC_SOF_HDA_LINK=y
CONFIG_SND_SOC_SOF_INTEL_TOPLEVEL=y
CONFIG_SND_SOC_SOF_PCI=m
CONFIG_SND_SOC_SOF_TOPLEVEL=y
CONFIG_SND_SOC_SSM4567=m
CONFIG_SND_SOC_TS3A227E=y
CONFIG_SOUNDWIRE=m
CONFIG_SX9310=m
CONFIG_TOUCHSCREEN_RM_TS=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_INPUT=y
CONFIG_VIRTIO_NET=m
CONFIG_VIRTIO_PCI=y
CONFIG_X86_INTEL_LPSS=y
# CONFIG_X86_KERNEL_IBT is not set
# CONFIG_X86_MCE_AMD is not set
CONFIG_X86_PKG_TEMP_THERMAL=y

# ===========================================================================
# OVERRIDES for nvidia-generic. Everything below is deliberate.
# ===========================================================================

# ---------------------------------------------------------------------------
# The iGPU. This is the whole basis of the Stage 2 safety design: the NVIDIA driver is
# brought up with nvidia-drm modeset=0 while amdgpu keeps the console, so a broken
# NVIDIA display path cannot lock us out.
#
# amd64-generic does not enable amdgpu at all -- CONFIG_DRM_AMDGPU appears nowhere in its
# kernel config, and the built image ships only evdi, radeon and vkms DRM modules. The
# machine's iGPU is Raphael [1002:164e], which needs amdgpu; radeon is the pre-GCN driver
# and will not bind to it. Without this the recovery console does not exist.
#
# Built as a module so it can be unloaded while debugging, and so a firmware problem
# degrades to "no iGPU" rather than a boot failure.
# ---------------------------------------------------------------------------
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_AMD_DC=y
CONFIG_DRM_AMD_DC_FP=y
# CONFIG_DRM_AMD_DC_SI is not set

# ---------------------------------------------------------------------------
# Nouveau MUST be a module, not built in.
#
# The generic flavour sets CONFIG_DRM_NOUVEAU=y. Built in, it cannot be blacklisted, and
# it would bind to the RTX before the NVIDIA driver gets a chance -- two drivers claiming
# one card. files/nvidia.conf blacklists nouveau, and a blacklist only works on a module.
#
# It is kept available on purpose: it is the control experiment that proves PCI
# enumeration and DRM/KMS work independently of NVIDIA's driver.
# ---------------------------------------------------------------------------
CONFIG_DRM_NOUVEAU=m

# ---------------------------------------------------------------------------
# Framebuffer console emulation on top of DRM.
#
# The generic flavour has "# CONFIG_DRM_FBDEV_EMULATION is not set". Without it a DRM
# driver provides no /dev/fb0 and therefore no text console, so Ctrl+Alt+F2 gives nothing
# and there is no way to read an error when the graphical session is broken. That is the
# exact scenario this project needs to survive. It is also what nvidia-drm's fbdev=1
# option has to attach to.
# ---------------------------------------------------------------------------
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y

# ---------------------------------------------------------------------------
# Last-resort console: the framebuffer UEFI already set up before any driver loaded.
# Needs no GPU driver and no firmware, so it survives amdgpu failing entirely.
#
# Note this gives a *text console only*. minigbm has no simpledrm backend (it has
# backend_amdgpu, backend_nouveau and others, but nothing for simple-framebuffer), so
# Chrome cannot allocate buffers on it and there will be no graphical session. That is
# fine: its job is to let us read errors, not to run a desktop.
# ---------------------------------------------------------------------------
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB_SIMPLEFB=y

# ---------------------------------------------------------------------------
# Loadable module support, stated explicitly rather than relied upon.
#
# Note what is NOT here. Earlier versions of this project treated CONFIG_CFI_CLANG,
# CONFIG_LTO_CLANG* and CONFIG_TRIM_UNUSED_KSYMS as blockers to disable. Grepping the
# whole of chromeos/config/ in the 6.12 tree returns ZERO occurrences of all three, so
# they were never enabled and never a problem. CONFIG_MODULE_SIG_FORCE is real, but it is
# set only in the reven flavour config, so it does not apply to this board either.
# ---------------------------------------------------------------------------
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# ---------------------------------------------------------------------------
# Memory-management features the NVIDIA modules use. ZONE_DEVICE appears only under
# termina/ in this tree and HMM_MIRROR nowhere, so both have to be set here.
# ---------------------------------------------------------------------------
CONFIG_MMU_NOTIFIER=y
CONFIG_ZONE_DEVICE=y
CONFIG_HMM_MIRROR=y
CONFIG_DEVICE_PRIVATE=y

# ---------------------------------------------------------------------------
# Large BARs. This card exposes a 16 GB prefetchable BAR1, so the kernel has to be
# willing to reallocate PCI resources to place it.
# ---------------------------------------------------------------------------
CONFIG_PCI_REALLOC_ENABLE_AUTO=y

# ---------------------------------------------------------------------------
# EFI variable filesystem. Needed to read or manage UEFI boot entries from the running
# system, which matters when installing to an internal disk.
# ---------------------------------------------------------------------------
CONFIG_EFIVAR_FS=y

# ---------------------------------------------------------------------------
# Diagnostics. When a GPU driver misbehaves the display is often the thing that broke, so
# the value of these is getting a log line instead of an unexplained hang. MCE_AMD is
# explicitly disabled in the generic flavour, which makes little sense on an AMD host.
# ---------------------------------------------------------------------------
CONFIG_PCIEAER=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_X86_MCE_AMD=y
